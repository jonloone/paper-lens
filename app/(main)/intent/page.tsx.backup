'use client';

import React, { useState, useRef, useEffect } from 'react';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Badge } from '@/components/ui/badge';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { 
  Send,
  Sparkles,
  Database,
  Zap,
  Calendar,
  ArrowRight,
  ChevronRight,
  Info,
  CheckCircle,
  AlertCircle,
  Loader2,
  GitBranch,
  Eye
} from 'lucide-react';
import { useRouter } from 'next/navigation';
import { cn } from '@/lib/utils';

interface Message {
  id: string;
  type: 'user' | 'assistant' | 'system';
  content: string;
  options?: Option[];
  data?: any;
  timestamp: Date;
}

interface Option {
  id: string;
  label: string;
  description?: string;
  icon?: React.ElementType;
  value: any;
}

interface DataSource {
  id: string;
  name: string;
  type: 'table' | 'stream' | 'api';
  description: string;
  schema?: string;
  freshness?: string;
  quality?: number;
  selected?: boolean;
}

export default function IntentRecognition() {
  const router = useRouter();
  const [messages, setMessages] = useState<Message[]>([
    {
      id: '1',
      type: 'assistant',
      content: 'Hello! I\'ll help you build a data pipeline. What would you like to achieve?',
      options: [
        {
          id: 'churn',
          label: 'Analyze customer churn',
          description: 'Identify customers likely to leave',
          icon: AlertCircle,
          value: { intent: 'churn_analysis' }
        },
        {
          id: 'revenue',
          label: 'Revenue forecasting',
          description: 'Predict future revenue trends',
          icon: ChevronRight,
          value: { intent: 'revenue_forecast' }
        },
        {
          id: 'quality',
          label: 'Data quality monitoring',
          description: 'Track and improve data quality',
          icon: CheckCircle,
          value: { intent: 'quality_monitoring' }
        },
        {
          id: 'custom',
          label: 'Something else',
          description: 'Describe your specific needs',
          icon: Sparkles,
          value: { intent: 'custom' }
        }
      ],
      timestamp: new Date()
    }
  ]);
  
  const [input, setInput] = useState('');
  const [isProcessing, setIsProcessing] = useState(false);
  const [currentStep, setCurrentStep] = useState<'intent' | 'data' | 'approach' | 'config' | 'preview'>('intent');
  const [pipelineConfig, setPipelineConfig] = useState<any>({});
  const messagesEndRef = useRef<HTMLDivElement>(null);

  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  };

  useEffect(() => {
    scrollToBottom();
  }, [messages]);

  // Mock data sources - in production, this would come from DataHub/catalog
  const availableDataSources: DataSource[] = [
    {
      id: 'customer_master',
      name: 'customer.master_table',
      type: 'table',
      description: 'Customer demographics and profile data',
      schema: 'customer',
      freshness: 'Daily',
      quality: 98
    },
    {
      id: 'order_history',
      name: 'orders.transactions',
      type: 'table',
      description: 'Historical order and transaction data',
      schema: 'orders',
      freshness: 'Real-time',
      quality: 95
    },
    {
      id: 'user_events',
      name: 'events.user_activity',
      type: 'stream',
      description: 'Real-time user behavior stream',
      schema: 'events',
      freshness: 'Streaming',
      quality: 92
    },
    {
      id: 'product_catalog',
      name: 'product.catalog',
      type: 'table',
      description: 'Product information and categories',
      schema: 'product',
      freshness: 'Hourly',
      quality: 99
    }
  ];

  const handleOptionClick = (option: Option) => {
    // Add user's selection as a message
    setMessages(prev => [...prev, {
      id: Date.now().toString(),
      type: 'user',
      content: option.label,
      timestamp: new Date()
    }]);

    setPipelineConfig({ ...pipelineConfig, ...option.value });
    
    // Process the selection
    processIntent(option.value);
  };

  const processIntent = async (value: any) => {
    setIsProcessing(true);
    
    // Simulate processing
    setTimeout(() => {
      // Handle different intents
      if (value.intent === 'churn_analysis') {
        setCurrentStep('data');
        setMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'assistant',
          content: 'Great choice! For customer churn analysis, I found these relevant data sources in your catalog:',
          data: {
            sources: availableDataSources.filter(s => 
              ['customer_master', 'order_history', 'user_events'].includes(s.id)
            )
          },
          timestamp: new Date()
        }]);
        
        setTimeout(() => {
          setMessages(prev => [...prev, {
            id: Date.now().toString(),
            type: 'system',
            content: 'Select the data sources you want to include in your analysis:',
            timestamp: new Date()
          }]);
        }, 500);
      } else if (value.intent === 'revenue_forecast') {
        setCurrentStep('data');
        setMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'assistant',
          content: 'Excellent! For revenue forecasting, these data sources will be most valuable:',
          data: {
            sources: availableDataSources.filter(s => 
              ['order_history', 'product_catalog', 'customer_master'].includes(s.id)
            )
          },
          timestamp: new Date()
        }]);
        
        setTimeout(() => {
          setMessages(prev => [...prev, {
            id: Date.now().toString(),
            type: 'system',
            content: 'Select the data sources you want to include in your forecast:',
            timestamp: new Date()
          }]);
        }, 500);
      } else if (value.intent === 'quality_monitoring') {
        setCurrentStep('data');
        setMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'assistant',
          content: 'Perfect! For data quality monitoring, I can help you track these data sources:',
          data: {
            sources: availableDataSources
          },
          timestamp: new Date()
        }]);
        
        setTimeout(() => {
          setMessages(prev => [...prev, {
            id: Date.now().toString(),
            type: 'system',
            content: 'Select the data sources you want to monitor for quality:',
            timestamp: new Date()
          }]);
        }, 500);
      } else if (value.intent === 'custom') {
        setCurrentStep('data');
        setMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'assistant',
          content: `I understand you want to ${value.description || 'build a custom pipeline'}. Let me show you available data sources:`,
          data: {
            sources: availableDataSources
          },
          timestamp: new Date()
        }]);
        
        setTimeout(() => {
          setMessages(prev => [...prev, {
            id: Date.now().toString(),
            type: 'system',
            content: 'Select the data sources relevant to your use case:',
            timestamp: new Date()
          }]);
        }, 500);
      } else if (value.step === 'data_selected') {
        setCurrentStep('approach');
        const intent = pipelineConfig.intent || 'custom';
        
        // Customize options based on intent
        let options = [];
        if (intent === 'churn_analysis') {
          options = [
            {
              id: 'batch',
              label: 'Batch Processing',
              description: 'Daily analysis for reporting',
              icon: Calendar,
              value: { approach: 'batch', schedule: 'daily' }
            },
            {
              id: 'streaming',
              label: 'Real-time Processing',
              description: 'Immediate churn detection',
              icon: Zap,
              value: { approach: 'streaming', latency: '<1min' }
            },
            {
              id: 'hybrid',
              label: 'Hybrid Approach',
              description: 'Real-time scoring with batch training',
              icon: GitBranch,
              value: { approach: 'hybrid' }
            }
          ];
        } else if (intent === 'revenue_forecast') {
          options = [
            {
              id: 'batch',
              label: 'Daily Forecasting',
              description: 'Update forecasts every morning',
              icon: Calendar,
              value: { approach: 'batch', schedule: 'daily' }
            },
            {
              id: 'hourly',
              label: 'Hourly Updates',
              description: 'Refresh forecasts throughout the day',
              icon: Zap,
              value: { approach: 'batch', schedule: 'hourly' }
            },
            {
              id: 'ml_enhanced',
              label: 'ML-Enhanced Forecasting',
              description: 'Use advanced ML models for predictions',
              icon: Sparkles,
              value: { approach: 'ml_batch', model: 'prophet' }
            }
          ];
        } else if (intent === 'quality_monitoring') {
          options = [
            {
              id: 'continuous',
              label: 'Continuous Monitoring',
              description: 'Real-time quality checks on ingestion',
              icon: Zap,
              value: { approach: 'streaming', checks: 'continuous' }
            },
            {
              id: 'scheduled',
              label: 'Scheduled Validation',
              description: 'Periodic quality assessment',
              icon: Calendar,
              value: { approach: 'batch', schedule: 'hourly' }
            },
            {
              id: 'sla_based',
              label: 'SLA-Based Monitoring',
              description: 'Track against defined SLAs',
              icon: CheckCircle,
              value: { approach: 'sla', alerting: true }
            }
          ];
        } else {
          // Custom intent - provide generic options
          options = [
            {
              id: 'batch',
              label: 'Batch Processing',
              description: 'Process data on a schedule',
              icon: Calendar,
              value: { approach: 'batch' }
            },
            {
              id: 'streaming',
              label: 'Stream Processing',
              description: 'Process data in real-time',
              icon: Zap,
              value: { approach: 'streaming' }
            },
            {
              id: 'api',
              label: 'API-Driven',
              description: 'On-demand processing via API',
              icon: GitBranch,
              value: { approach: 'api' }
            }
          ];
        }
        
        setMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'assistant',
          content: 'Perfect! Now, how would you like to process this data?',
          options,
          timestamp: new Date()
        }]);
      } else if (value.approach) {
        setCurrentStep('preview');
        generatePipeline({ ...pipelineConfig, ...value });
      } else if (value.action) {
        // Handle final actions
        handleFinalAction(value.action);
      }
      
      setIsProcessing(false);
    }, 1000);
  };

  const generatePipeline = (config: any) => {
    const intent = config.intent || 'custom';
    let pipelineDescription = '';
    let pipelineSteps = [];
    
    // Generate appropriate pipeline based on intent
    if (intent === 'churn_analysis') {
      pipelineDescription = `Excellent! I've designed a ${config.approach} pipeline for your churn analysis. Here's what it will do:`;
      pipelineSteps = [
        '1. Ingest customer data from selected sources',
        '2. Join and enrich customer profiles with transaction history',
        '3. Calculate churn indicators (days since last purchase, engagement score)',
        '4. Apply ML model for churn prediction',
        '5. Store results in analytics-ready format',
        '6. Expose via API for applications'
      ];
    } else if (intent === 'revenue_forecast') {
      pipelineDescription = `Great! I've created a ${config.approach || 'forecasting'} pipeline for revenue prediction. Here's the workflow:`;
      pipelineSteps = [
        '1. Extract historical transaction and product data',
        '2. Aggregate revenue metrics by time period',
        '3. Apply seasonal decomposition and trend analysis',
        '4. Generate forecasts using time-series models',
        '5. Calculate confidence intervals and accuracy metrics',
        '6. Publish forecasts to dashboard and alerts'
      ];
    } else if (intent === 'quality_monitoring') {
      pipelineDescription = `Perfect! I've configured a ${config.approach || 'monitoring'} pipeline for data quality. It will:`;
      pipelineSteps = [
        '1. Connect to selected data sources for monitoring',
        '2. Apply data quality rules (completeness, accuracy, consistency)',
        '3. Profile data distributions and detect anomalies',
        '4. Generate quality scores and trend reports',
        '5. Alert on quality degradation or SLA breaches',
        '6. Update data catalog with quality metrics'
      ];
    } else {
      pipelineDescription = `Excellent! I've designed a ${config.approach || 'custom'} pipeline based on your requirements. Here's what it will do:`;
      pipelineSteps = [
        '1. Connect to your selected data sources',
        '2. Apply necessary transformations and enrichments',
        '3. Implement business logic and calculations',
        '4. Validate data quality and completeness',
        '5. Store processed results in target systems',
        '6. Enable downstream consumption via APIs or exports'
      ];
    }
    
    setMessages(prev => [...prev, {
      id: Date.now().toString(),
      type: 'assistant',
      content: pipelineDescription,
      timestamp: new Date()
    }]);
    
    setTimeout(() => {
      setMessages(prev => [...prev, {
        id: Date.now().toString(),
        type: 'system',
        content: pipelineSteps.join('\n'),
        timestamp: new Date()
      }]);
      
      setTimeout(() => {
        setMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'assistant',
          content: 'Would you like to:',
          options: [
            {
              id: 'visualize',
              label: 'Open in Visual Builder',
              description: 'Fine-tune the pipeline visually',
              icon: Eye,
              value: { action: 'visualize' }
            },
            {
              id: 'deploy',
              label: 'Deploy to Development',
              description: 'Test with sample data',
              icon: Zap,
              value: { action: 'deploy' }
            },
            {
              id: 'modify',
              label: 'Modify Requirements',
              description: 'Change data sources or approach',
              icon: Sparkles,
              value: { action: 'modify' }
            }
          ],
          timestamp: new Date()
        }]);
      }, 500);
    }, 1000);
  };

  const handleSendMessage = () => {
    if (!input.trim()) return;
    
    setMessages(prev => [...prev, {
      id: Date.now().toString(),
      type: 'user',
      content: input,
      timestamp: new Date()
    }]);
    
    setInput('');
    
    // Process natural language input
    processNaturalLanguage(input);
  };

  const processNaturalLanguage = (text: string) => {
    setIsProcessing(true);
    
    // Simple intent recognition - in production, use proper NLP
    const lowerText = text.toLowerCase();
    
    setTimeout(() => {
      if (lowerText.includes('churn') || lowerText.includes('leaving') || lowerText.includes('retention')) {
        processIntent({ intent: 'churn_analysis' });
      } else if (lowerText.includes('revenue') || lowerText.includes('sales') || lowerText.includes('forecast')) {
        processIntent({ intent: 'revenue_forecast' });
      } else if (lowerText.includes('quality') || lowerText.includes('monitor') || lowerText.includes('validate')) {
        processIntent({ intent: 'quality_monitoring' });
      } else {
        setMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'assistant',
          content: `I understand you want to ${text}. Let me help you identify the right data sources and approach.`,
          timestamp: new Date()
        }]);
        
        setTimeout(() => {
          processIntent({ intent: 'custom', description: text });
        }, 500);
      }
      
      setIsProcessing(false);
    }, 1000);
  };

  const handleFinalAction = (action: string) => {
    switch (action) {
      case 'visualize':
        // Navigate to visual builder with pipeline config
        router.push(`/builder?config=${encodeURIComponent(JSON.stringify(pipelineConfig))}`);
        break;
      case 'deploy':
        setMessages(prev => [...prev, {
          id: Date.now().toString(),
          type: 'assistant',
          content: '🚀 Deploying your pipeline to development environment...',
          timestamp: new Date()
        }]);
        setTimeout(() => {
          setMessages(prev => [...prev, {
            id: Date.now().toString(),
            type: 'system',
            content: '✅ Pipeline successfully deployed!\n\n• Environment: Development\n• Status: Running\n• Endpoint: https://api.nexusone.dev/pipelines/p-' + Date.now().toString().slice(-6),
            timestamp: new Date()
          }]);
        }, 2000);
        break;
      case 'modify':
        // Reset to intent step
        setCurrentStep('intent');
        setPipelineConfig({});
        setMessages([{
          id: Date.now().toString(),
          type: 'assistant',
          content: 'Let\'s start over. What would you like to build?',
          options: [
            {
              id: 'churn',
              label: 'Analyze customer churn',
              description: 'Identify customers likely to leave',
              icon: AlertCircle,
              value: { intent: 'churn_analysis' }
            },
            {
              id: 'revenue',
              label: 'Revenue forecasting',
              description: 'Predict future revenue trends',
              icon: ChevronRight,
              value: { intent: 'revenue_forecast' }
            },
            {
              id: 'quality',
              label: 'Data quality monitoring',
              description: 'Track and improve data quality',
              icon: CheckCircle,
              value: { intent: 'quality_monitoring' }
            },
            {
              id: 'custom',
              label: 'Something else',
              description: 'Describe your specific needs',
              icon: Sparkles,
              value: { intent: 'custom' }
            }
          ],
          timestamp: new Date()
        }]);
        break;
    }
  };

  const handleDataSourceToggle = (sourceId: string) => {
    // Toggle data source selection
    const updatedSources = { ...pipelineConfig.dataSources } || {};
    updatedSources[sourceId] = !updatedSources[sourceId];
    setPipelineConfig({ ...pipelineConfig, dataSources: updatedSources });
  };

  const proceedWithDataSources = () => {
    const selectedSources = Object.keys(pipelineConfig.dataSources || {})
      .filter(key => pipelineConfig.dataSources[key]);
    
    if (selectedSources.length === 0) {
      alert('Please select at least one data source');
      return;
    }
    
    setMessages(prev => [...prev, {
      id: Date.now().toString(),
      type: 'user',
      content: `Selected ${selectedSources.length} data sources`,
      timestamp: new Date()
    }]);
    
    processIntent({ step: 'data_selected', sources: selectedSources });
  };

  return (
    <div className="container mx-auto py-6 max-w-6xl">
      {/* Header */}
      <div className="mb-6">
        <h1 className="text-2xl font-semibold">Intelligent Pipeline Builder</h1>
        <p className="text-muted-foreground">
          Describe what you want to achieve, and I'll help you build the right pipeline
        </p>
      </div>

      <div className="grid grid-cols-12 gap-6">
        {/* Chat Interface */}
        <div className="col-span-8">
          <Card className="h-[600px] flex flex-col">
            <CardHeader className="pb-3">
              <div className="flex items-center justify-between">
                <CardTitle className="text-base">Pipeline Assistant</CardTitle>
                <div className="flex items-center gap-2">
                  {['intent', 'data', 'approach', 'config', 'preview'].map((step, idx) => (
                    <React.Fragment key={step}>
                      <div className={cn(
                        "w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium",
                        currentStep === step ? "bg-primary text-primary-foreground" : 
                        idx < ['intent', 'data', 'approach', 'config', 'preview'].indexOf(currentStep) ? 
                        "bg-green-100 text-green-700" : "bg-gray-100 text-gray-400"
                      )}>
                        {idx + 1}
                      </div>
                      {idx < 4 && <ChevronRight className="h-4 w-4 text-gray-400" />}
                    </React.Fragment>
                  ))}
                </div>
              </div>
            </CardHeader>
            
            <CardContent className="flex-1 flex flex-col p-0">
              {/* Messages */}
              <div className="flex-1 overflow-auto p-4 space-y-4">
                {messages.map((message) => (
                  <div key={message.id} className={cn(
                    "flex",
                    message.type === 'user' ? 'justify-end' : 'justify-start'
                  )}>
                    <div className={cn(
                      "max-w-[80%] rounded-lg p-3",
                      message.type === 'user' ? 'bg-primary text-primary-foreground' :
                      message.type === 'system' ? 'bg-muted' : 'bg-secondary'
                    )}>
                      <div className="text-sm whitespace-pre-wrap">{message.content}</div>
                      
                      {/* Options */}
                      {message.options && (
                        <div className="mt-3 space-y-2">
                          {message.options.map((option) => (
                            <button
                              key={option.id}
                              onClick={() => handleOptionClick(option)}
                              className="w-full text-left p-3 bg-white rounded-lg border hover:border-primary transition-colors"
                            >
                              <div className="flex items-start gap-3">
                                {option.icon && (
                                  <div className="p-1.5 bg-primary/10 rounded">
                                    <option.icon className="h-4 w-4 text-primary" />
                                  </div>
                                )}
                                <div className="flex-1">
                                  <div className="font-medium text-sm">{option.label}</div>
                                  {option.description && (
                                    <div className="text-xs text-muted-foreground mt-0.5">
                                      {option.description}
                                    </div>
                                  )}
                                </div>
                              </div>
                            </button>
                          ))}
                        </div>
                      )}
                      
                      {/* Data Sources */}
                      {message.data?.sources && (
                        <div className="mt-3 space-y-2">
                          {message.data.sources.map((source: DataSource) => (
                            <div
                              key={source.id}
                              className="p-3 bg-white rounded-lg border"
                            >
                              <div className="flex items-start justify-between">
                                <div className="flex-1">
                                  <div className="flex items-center gap-2">
                                    <Database className="h-4 w-4 text-gray-500" />
                                    <span className="font-medium text-sm">{source.name}</span>
                                    <Badge variant="outline" className="text-xs">
                                      {source.type}
                                    </Badge>
                                  </div>
                                  <div className="text-xs text-muted-foreground mt-1">
                                    {source.description}
                                  </div>
                                  <div className="flex items-center gap-3 mt-2 text-xs">
                                    <span>Freshness: {source.freshness}</span>
                                    <span>Quality: {source.quality}%</span>
                                  </div>
                                </div>
                                <input
                                  type="checkbox"
                                  checked={pipelineConfig.dataSources?.[source.id] || false}
                                  onChange={() => handleDataSourceToggle(source.id)}
                                  className="mt-1"
                                />
                              </div>
                            </div>
                          ))}
                          <Button 
                            size="sm" 
                            className="w-full"
                            onClick={proceedWithDataSources}
                          >
                            Continue with selected sources
                          </Button>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
                
                {isProcessing && (
                  <div className="flex justify-start">
                    <div className="bg-secondary rounded-lg p-3">
                      <Loader2 className="h-4 w-4 animate-spin" />
                    </div>
                  </div>
                )}
                
                <div ref={messagesEndRef} />
              </div>
              
              {/* Input */}
              <div className="border-t p-4">
                <div className="flex gap-2">
                  <Input
                    value={input}
                    onChange={(e) => setInput(e.target.value)}
                    onKeyPress={(e) => e.key === 'Enter' && handleSendMessage()}
                    placeholder="Describe what you want to build..."
                    className="flex-1"
                  />
                  <Button onClick={handleSendMessage} disabled={isProcessing}>
                    <Send className="h-4 w-4" />
                  </Button>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>

        {/* Side Panel */}
        <div className="col-span-4 space-y-4">
          {/* Pipeline Summary */}
          <Card>
            <CardHeader>
              <CardTitle className="text-base">Pipeline Configuration</CardTitle>
            </CardHeader>
            <CardContent>
              {Object.keys(pipelineConfig).length > 0 ? (
                <div className="space-y-3">
                  {pipelineConfig.intent && (
                    <div>
                      <div className="text-xs font-medium text-muted-foreground">Intent</div>
                      <div className="text-sm">{pipelineConfig.intent.replace('_', ' ')}</div>
                    </div>
                  )}
                  {pipelineConfig.dataSources && (
                    <div>
                      <div className="text-xs font-medium text-muted-foreground">Data Sources</div>
                      <div className="text-sm">
                        {Object.keys(pipelineConfig.dataSources)
                          .filter(k => pipelineConfig.dataSources[k])
                          .length} selected
                      </div>
                    </div>
                  )}
                  {pipelineConfig.approach && (
                    <div>
                      <div className="text-xs font-medium text-muted-foreground">Processing</div>
                      <div className="text-sm capitalize">{pipelineConfig.approach}</div>
                    </div>
                  )}
                </div>
              ) : (
                <p className="text-sm text-muted-foreground">
                  Your pipeline configuration will appear here as you make selections
                </p>
              )}
            </CardContent>
          </Card>

          {/* Suggestions */}
          <Card>
            <CardHeader>
              <CardTitle className="text-base">Common Use Cases</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="space-y-2">
                <button className="w-full text-left p-2 hover:bg-muted rounded transition-colors">
                  <div className="text-sm font-medium">Customer Lifetime Value</div>
                  <div className="text-xs text-muted-foreground">Predict customer value over time</div>
                </button>
                <button className="w-full text-left p-2 hover:bg-muted rounded transition-colors">
                  <div className="text-sm font-medium">Fraud Detection</div>
                  <div className="text-xs text-muted-foreground">Real-time transaction monitoring</div>
                </button>
                <button className="w-full text-left p-2 hover:bg-muted rounded transition-colors">
                  <div className="text-sm font-medium">Product Recommendations</div>
                  <div className="text-xs text-muted-foreground">Personalized suggestions</div>
                </button>
              </div>
            </CardContent>
          </Card>

          {/* Actions */}
          {currentStep === 'preview' && (
            <Card>
              <CardContent className="p-4">
                <Button 
                  className="w-full" 
                  onClick={() => router.push('/builder')}
                >
                  <Eye className="h-4 w-4 mr-2" />
                  Open in Visual Builder
                </Button>
              </CardContent>
            </Card>
          )}
        </div>
      </div>
    </div>
  );
}