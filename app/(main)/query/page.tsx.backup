'use client';

import React, { useState, useEffect } from 'react';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { ScrollArea } from '@/components/ui/scroll-area';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Input } from '@/components/ui/input';
import { SQLEditor } from '@tidbcloud/tisqleditor-react';
import { oneDark } from '@tidbcloud/codemirror-extension-themes';
import { curSqlGutter } from '@tidbcloud/codemirror-extension-cur-sql-gutter';
import {
  Brain,
  Database,
  FileCode,
  Folder,
  FolderOpen,
  History,
  Loader2,
  Play,
  Save,
  Search,
  Sparkles,
  Table,
  Timer,
  TrendingUp,
  X,
  Eye,
  ChevronRight,
  ChevronDown,
  Star,
  Download,
  Share2,
  ExternalLink,
  Plus
} from 'lucide-react';
import { trinoClient } from '@/lib/integrations/trinoClient';
import { AIAssistantPanel } from '@/components/query/AIAssistantPanel';
import { QueryLibrary, SavedQuery } from '@/components/query/QueryLibrary';
import { sqlAIAssistant } from '@/lib/extensions/sqlAIAssistant';

// Updated SavedQuery interface to match QueryLibrary component

interface QueryResult {
  columns: { name: string; type: string }[];
  data: any[][];
  stats: {
    executionTime: number;
    processedRows: number;
    processedBytes: number;
  };
}

interface SchemaTable {
  columns: Array<{
    name: string;
    type: string;
    nullable: boolean;
  }>;
  partitions: string[];
  format: string;
  rows: string;
  size: string;
}

// Enhanced mock schema data
const MOCK_SCHEMAS: Record<string, Record<string, SchemaTable>> = {
  'hive': {
    'customers': {
      columns: [
        { name: 'customer_id', type: 'varchar', nullable: false },
        { name: 'customer_name', type: 'varchar', nullable: false },
        { name: 'email', type: 'varchar', nullable: true },
        { name: 'segment', type: 'varchar', nullable: true },
        { name: 'created_at', type: 'timestamp', nullable: false }
      ],
      partitions: [],
      format: 'Parquet',
      rows: '45K',
      size: '12MB'
    },
    'orders': {
      columns: [
        { name: 'order_id', type: 'bigint', nullable: false },
        { name: 'customer_id', type: 'varchar', nullable: false },
        { name: 'product_id', type: 'varchar', nullable: false },
        { name: 'order_amount', type: 'decimal(10,2)', nullable: false },
        { name: 'order_date', type: 'timestamp', nullable: false },
        { name: 'status', type: 'varchar', nullable: true }
      ],
      partitions: ['order_date'],
      format: 'Parquet',
      rows: '1.2M',
      size: '450MB'
    },
    'products': {
      columns: [
        { name: 'product_id', type: 'varchar', nullable: false },
        { name: 'product_name', type: 'varchar', nullable: false },
        { name: 'category', type: 'varchar', nullable: true },
        { name: 'price', type: 'decimal(10,2)', nullable: false },
        { name: 'created_at', type: 'timestamp', nullable: false }
      ],
      partitions: [],
      format: 'Parquet',
      rows: '2.5K',
      size: '1MB'
    }
  },
  'postgresql': {
    'users': {
      columns: [
        { name: 'id', type: 'integer', nullable: false },
        { name: 'username', type: 'varchar', nullable: false },
        { name: 'email', type: 'varchar', nullable: false }
      ],
      partitions: [],
      format: 'PostgreSQL',
      rows: '100K',
      size: '25MB'
    }
  }
};

export default function QueryPage() {
  const [query, setQuery] = useState(`-- AI-Powered SQL Editor
-- Try asking the AI assistant to generate queries for you!

SELECT 
  c.customer_name,
  COUNT(o.order_id) as total_orders,
  SUM(o.order_amount) as total_revenue
FROM hive.default.customers c
LEFT JOIN hive.default.orders o ON c.customer_id = o.customer_id
WHERE o.order_date >= DATE('2024-01-01')
GROUP BY c.customer_name
ORDER BY total_revenue DESC
LIMIT 10;`);
  
  const [catalog, setCatalog] = useState('hive');
  const [schema, setSchema] = useState('default');
  const [isExecuting, setIsExecuting] = useState(false);
  const [results, setResults] = useState<QueryResult | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [activeTab, setActiveTab] = useState('editor');
  
  // Schema Browser
  const [expandedTables, setExpandedTables] = useState<Set<string>>(new Set());
  const [schemaSearchTerm, setSchemaSearchTerm] = useState('');
  
  // Query Library
  const [savedQueries, setSavedQueries] = useState<SavedQuery[]>([]);
  const [selectedQuery, setSelectedQuery] = useState<string | null>(null);
  
  // AI Assistant
  const [aiVisible, setAiVisible] = useState(true); // Start with AI visible

  // Load saved queries on mount
  useEffect(() => {
    loadSavedQueries();
  }, []);

  const loadSavedQueries = () => {
    const mockQueries: SavedQuery[] = [
      {
        id: '1',
        name: 'Customer Revenue Analysis',
        description: 'Monthly revenue by customer segment',
        sql: `SELECT 
  c.segment,
  DATE_TRUNC('month', o.order_date) as month,
  SUM(o.order_amount) as revenue,
  COUNT(DISTINCT c.customer_id) as customers
FROM hive.default.customers c
JOIN hive.default.orders o ON c.customer_id = o.customer_id
WHERE o.order_date >= DATE('2024-01-01')
GROUP BY c.segment, DATE_TRUNC('month', o.order_date)
ORDER BY month DESC, revenue DESC;`,
        catalog: 'hive',
        schema: 'default',
        createdAt: new Date('2024-09-15'),
        updatedAt: new Date('2024-09-16'),
        lastExecuted: new Date('2024-09-16'),
        tags: ['revenue', 'customer', 'analytics'],
        author: 'john.doe',
        starred: true,
        executionCount: 25,
        avgExecutionTime: 1250
      },
      {
        id: '2',
        name: 'Product Performance',
        description: 'Top selling products by category',
        sql: `SELECT 
  p.category,
  p.product_name,
  COUNT(o.order_id) as orders,
  SUM(o.order_amount) as total_revenue
FROM hive.default.products p
JOIN hive.default.orders o ON p.product_id = o.product_id
WHERE o.order_date >= CURRENT_DATE - INTERVAL '30' DAY
GROUP BY p.category, p.product_name
ORDER BY total_revenue DESC
LIMIT 20;`,
        catalog: 'hive',
        schema: 'default',
        createdAt: new Date('2024-09-10'),
        updatedAt: new Date('2024-09-15'),
        tags: ['products', 'sales', 'performance'],
        author: 'jane.smith',
        starred: false,
        executionCount: 12,
        avgExecutionTime: 850
      },
      {
        id: '3',
        name: 'Data Quality Check',
        description: 'Check for null values and duplicates',
        sql: `SELECT 
  'customers' as table_name,
  COUNT(*) as total_rows,
  COUNT(DISTINCT customer_id) as unique_customers,
  SUM(CASE WHEN email IS NULL THEN 1 ELSE 0 END) as null_emails
FROM hive.default.customers
UNION ALL
SELECT 
  'orders' as table_name,
  COUNT(*) as total_rows,
  COUNT(DISTINCT order_id) as unique_orders,
  SUM(CASE WHEN customer_id IS NULL THEN 1 ELSE 0 END) as null_customer_ids
FROM hive.default.orders;`,
        catalog: 'hive',
        schema: 'default',
        createdAt: new Date('2024-09-12'),
        updatedAt: new Date('2024-09-14'),
        tags: ['quality', 'validation'],
        author: 'john.doe',
        starred: false,
        executionCount: 8,
        avgExecutionTime: 450
      }
    ];
    setSavedQueries(mockQueries);
  };

  const executeQuery = async () => {
    if (!query.trim()) return;
    
    setIsExecuting(true);
    setError(null);
    
    try {
      const result = await trinoClient.executeQuery(query, 100);
      setResults(result);
      setActiveTab('results');
    } catch (err: any) {
      setError(err.message || 'Query execution failed');
      console.error('Query execution error:', err);
    } finally {
      setIsExecuting(false);
    }
  };


  const toggleTable = (table: string) => {
    const newExpanded = new Set(expandedTables);
    if (newExpanded.has(table)) {
      newExpanded.delete(table);
    } else {
      newExpanded.add(table);
    }
    setExpandedTables(newExpanded);
  };

  const previewTable = (tableName: string) => {
    const previewQuery = `SELECT * FROM ${catalog}.${schema}.${tableName} LIMIT 100;`;
    setQuery(previewQuery);
    setActiveTab('editor');
  };


  const formatBytes = (bytes: number) => {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(2)} KB`;
    if (bytes < 1024 * 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    return `${(bytes / (1024 * 1024 * 1024)).toFixed(2)} GB`;
  };

  const formatDuration = (ms: number) => {
    if (ms < 1000) return `${ms}ms`;
    return `${(ms / 1000).toFixed(2)}s`;
  };

  return (
    <div className="h-screen flex flex-col">
      {/* Header */}
      <div className="border-b p-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-4">
            <Database className="h-6 w-6 text-primary" />
            <div>
              <h1 className="text-2xl font-bold">Query Studio</h1>
              <p className="text-sm text-muted-foreground">
                Professional SQL development with AI assistance
              </p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <Button
              variant="outline"
              size="sm"
              onClick={() => window.open('/build?tab=studio', '_blank')}
            >
              <ExternalLink className="h-4 w-4 mr-2" />
              Pipeline Studio
            </Button>
            <Select value={catalog} onValueChange={setCatalog}>
              <SelectTrigger className="w-[120px]">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="hive">hive</SelectItem>
                <SelectItem value="postgresql">postgresql</SelectItem>
              </SelectContent>
            </Select>
            <Select value={schema} onValueChange={setSchema}>
              <SelectTrigger className="w-[120px]">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="default">default</SelectItem>
                <SelectItem value="staging">staging</SelectItem>
                <SelectItem value="analytics">analytics</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>
      </div>

      {/* Main Content */}
      <div className="flex-1 flex">
        {/* Left Sidebar - Schema Browser */}
        <div className="w-64 border-r bg-muted/20">
          <div className="p-4">
            <h3 className="font-semibold mb-3 flex items-center gap-2">
              <Database className="h-4 w-4" />
              Schema Browser
            </h3>
            
            <div className="relative mb-4">
              <Search className="absolute left-2 top-2.5 h-4 w-4 text-muted-foreground" />
              <Input
                placeholder="Search tables..."
                value={schemaSearchTerm}
                onChange={(e) => setSchemaSearchTerm(e.target.value)}
                className="pl-8"
              />
            </div>

            <Alert className="mb-4">
              <Database className="h-4 w-4" />
              <AlertDescription className="text-xs">
                {catalog}.{schema}
              </AlertDescription>
            </Alert>
            
            <ScrollArea className="h-[calc(100vh-280px)]">
              <div className="space-y-1">
                {Object.entries(MOCK_SCHEMAS[catalog] || {})
                  .filter(([name]) => !schemaSearchTerm || name.toLowerCase().includes(schemaSearchTerm.toLowerCase()))
                  .map(([tableName, tableInfo]) => (
                    <div key={tableName} className="border rounded-lg">
                      <button
                        onClick={() => toggleTable(tableName)}
                        className="w-full p-2 text-left hover:bg-muted rounded-lg flex items-center justify-between text-sm"
                      >
                        <div className="flex items-center gap-2">
                          <Table className="h-3 w-3" />
                          {tableName}
                        </div>
                        <div className="flex items-center gap-2">
                          <span className="text-xs text-muted-foreground">{tableInfo.rows}</span>
                          {expandedTables.has(tableName) ? 
                            <ChevronDown className="h-3 w-3" /> : 
                            <ChevronRight className="h-3 w-3" />
                          }
                        </div>
                      </button>
                      
                      {expandedTables.has(tableName) && (
                        <div className="px-2 pb-2">
                          <div className="bg-muted/50 rounded p-2 text-xs space-y-1">
                            <div className="flex justify-between text-muted-foreground mb-2">
                              <span>{tableInfo.format}</span>
                              <span>{tableInfo.size}</span>
                            </div>
                            {tableInfo.columns.slice(0, 5).map((col) => (
                              <div key={col.name} className="flex justify-between">
                                <span className="font-mono">{col.name}</span>
                                <span className="text-muted-foreground">{col.type}</span>
                              </div>
                            ))}
                            {tableInfo.columns.length > 5 && (
                              <div className="text-muted-foreground">
                                +{tableInfo.columns.length - 5} more columns
                              </div>
                            )}
                            <Button
                              size="sm"
                              variant="ghost"
                              className="w-full mt-2"
                              onClick={() => previewTable(tableName)}
                            >
                              <Eye className="h-3 w-3 mr-2" />
                              Preview Data
                            </Button>
                          </div>
                        </div>
                      )}
                    </div>
                  ))}
              </div>
            </ScrollArea>
          </div>
        </div>

        {/* Center - Editor Area */}
        <div className="flex-1 flex flex-col">
          <Tabs value={activeTab} onValueChange={setActiveTab} className="flex-1 flex flex-col">
            <div className="border-b p-2">
              <div className="flex items-center justify-between">
                <TabsList>
                  <TabsTrigger value="editor">Editor</TabsTrigger>
                  <TabsTrigger value="results" disabled={!results}>
                    Results {results && <Badge className="ml-2" variant="secondary">{results.data.length}</Badge>}
                  </TabsTrigger>
                </TabsList>
                
                <div className="flex gap-2">
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => setAiVisible(!aiVisible)}
                  >
                    <Brain className="h-4 w-4 mr-2" />
                    AI Assistant
                  </Button>
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={executeQuery}
                    disabled={isExecuting || !query.trim()}
                  >
                    {isExecuting ? (
                      <Loader2 className="h-4 w-4 mr-2 animate-spin" />
                    ) : (
                      <Play className="h-4 w-4 mr-2" />
                    )}
                    Run Query
                  </Button>
                  <Button 
                    size="sm" 
                    onClick={() => {
                      // The save functionality is now handled by the QueryLibrary component
                      // The user can use the "Save Current Query" button in the library panel
                      alert('Use the "Save Current Query" button in the Query Library panel on the right to save your query.');
                    }} 
                    disabled={!query.trim()}
                  >
                    <Save className="h-4 w-4 mr-2" />
                    Save
                  </Button>
                </div>
              </div>
            </div>

            <TabsContent value="editor" className="flex-1 flex">
              <div className="flex-1 flex">
                <div className="flex-1 border rounded-lg m-2 overflow-hidden">
                  <SQLEditor
                    editorId="main-sql-editor"
                    doc={query}
                    onChange={setQuery}
                    theme={oneDark}
                    basicSetupOptions={{
                      autocompletion: true,
                      lineNumbers: true,
                      highlightSelectionMatches: true,
                      foldGutter: true,
                      searchKeymap: true
                    }}
                    extraExts={[
                      curSqlGutter(),
                      sqlAIAssistant({
                        enabled: true,
                        catalog,
                        schema
                      })
                    ]}
                  />
                </div>

                {/* AI Assistant Panel */}
                {aiVisible && (
                  <div className="w-80 m-2">
                    <AIAssistantPanel
                      currentQuery={query}
                      catalog={catalog}
                      schema={schema}
                      onQueryInsert={(newQuery) => {
                        const currentPos = query.length;
                        setQuery(query + '\n\n' + newQuery);
                      }}
                      onQueryReplace={(newQuery) => {
                        setQuery(newQuery);
                      }}
                    />
                  </div>
                )}
              </div>

              {error && (
                <Alert variant="destructive" className="m-2">
                  <AlertDescription>{error}</AlertDescription>
                </Alert>
              )}
            </TabsContent>

            <TabsContent value="results" className="flex-1 p-2">
              {results && (
                <div className="h-full flex flex-col gap-4">
                  <div className="flex items-center justify-between">
                    <div className="flex gap-2">
                      <Badge variant="outline">
                        <Timer className="h-3 w-3 mr-1" />
                        {formatDuration(results.stats.executionTime)}
                      </Badge>
                      <Badge variant="outline">
                        <Table className="h-3 w-3 mr-1" />
                        {results.data.length} rows
                      </Badge>
                      <Badge variant="outline">
                        <Database className="h-3 w-3 mr-1" />
                        {formatBytes(results.stats.processedBytes)}
                      </Badge>
                    </div>
                    <Button variant="outline" size="sm">
                      <Download className="h-4 w-4 mr-2" />
                      Export CSV
                    </Button>
                  </div>

                  <Card className="flex-1 overflow-hidden">
                    <ScrollArea className="h-full">
                      <table className="w-full text-sm">
                        <thead className="sticky top-0 bg-background border-b">
                          <tr>
                            {results.columns.map((col, idx) => (
                              <th key={idx} className="text-left p-2 font-medium">
                                {col.name}
                                <span className="text-xs text-muted-foreground ml-1">
                                  ({col.type})
                                </span>
                              </th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {results.data.map((row, ridx) => (
                            <tr key={ridx} className="border-b hover:bg-muted/50">
                              {row.map((cell, cidx) => (
                                <td key={cidx} className="p-2">
                                  {cell?.toString() || 'NULL'}
                                </td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </ScrollArea>
                  </Card>
                </div>
              )}
            </TabsContent>
          </Tabs>
        </div>

        {/* Right Sidebar - Query Library */}
        <div className="w-80 border-l bg-muted/20">
          <QueryLibrary
            queries={savedQueries}
            onQuerySelect={(savedQuery) => {
              setQuery(savedQuery.sql);
              setCatalog(savedQuery.catalog);
              setSchema(savedQuery.schema);
              setSelectedQuery(savedQuery.id);
              setActiveTab('editor');
            }}
            onQueryExecute={(savedQuery) => {
              setQuery(savedQuery.sql);
              setCatalog(savedQuery.catalog);
              setSchema(savedQuery.schema);
              executeQuery();
            }}
            onQuerySave={(newQuery) => {
              const fullQuery: SavedQuery = {
                id: Date.now().toString(),
                name: newQuery.name || 'Untitled Query',
                description: newQuery.description || '',
                sql: newQuery.sql || query,
                catalog: newQuery.catalog || catalog,
                schema: newQuery.schema || schema,
                tags: newQuery.tags || [],
                author: newQuery.author || 'current-user',
                createdAt: new Date(),
                updatedAt: new Date(),
                starred: newQuery.starred || false,
                executionCount: 0
              };
              setSavedQueries(prev => [fullQuery, ...prev]);
            }}
            onQueryDelete={(queryId) => {
              setSavedQueries(prev => prev.filter(q => q.id !== queryId));
            }}
            onQueryStar={(queryId, starred) => {
              setSavedQueries(prev => prev.map(q => 
                q.id === queryId ? { ...q, starred } : q
              ));
            }}
            currentQuery={query}
            currentCatalog={catalog}
            currentSchema={schema}
          />
        </div>
      </div>
    </div>
  );
}